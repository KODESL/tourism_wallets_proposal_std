@startuml EUDI_Credential_ER_Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam classBackgroundColor #B8D4E0
skinparam classArrowColor #2C5F77

title EUDI Wallet - Credential Store Schema

entity "credentials" as credentials {
  **id** : TEXT <<PK>>
  ==
  type : TEXT <<indexed>>
  issuer : TEXT <<indexed>>
  expires_at : INTEGER <<indexed>>
  created_at : INTEGER
  ==
  raw_credential : TEXT
  sd_jwt : TEXT
  disclosures : TEXT
  ==
  metadata_json : TEXT
}

note as idx_type
  **Index: idx_type**
  Column: type
  Type: B-Tree
  Usage: Fast retrieval by type
end note

note as idx_issuer
  **Index: idx_issuer**
  Column: issuer
  Type: B-Tree
  Usage: Filter by issuer
end note

note as idx_expires
  **Index: idx_expires**
  Column: expires_at
  Type: B-Tree
  Usage: Expiry cleanup
end note

note as idx_composite
  **Index: idx_type_expires**
  Columns: type, expires_at
  Type: Composite B-Tree
  Usage: Active credentials by type
end note

credentials .. idx_type
credentials .. idx_issuer
credentials .. idx_expires
credentials .. idx_composite

note right of credentials
  **Query patterns**

  SELECT * FROM credentials
  WHERE type = ?
  AND expires_at > ?
  ORDER BY created_at DESC

  **Complexity: O(log n)**
  Uses composite index
end note

note bottom of credentials
  **Security considerations**

  - Encrypted at filesystem level
  - SQLCipher planned for table-level encryption
  - No PII in indexed columns
  - Credential payload in raw_credential
end note

@enduml
